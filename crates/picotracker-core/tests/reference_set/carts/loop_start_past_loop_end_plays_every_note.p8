pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- picotracker reference case loop_start_past_loop_end_plays_every_note: records 288 ticks
printh("VERSION "..stat(5))
extcmd("set_filename","recording")
extcmd("audio_rec")
music(0)
for i=1,87 do flip() end
extcmd("audio_end",1)
printh("ALLDONE")
while true do flip() end
