pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- picotracker reference case drop_on_an_sfx_instrument_keeps_the_pitch: records 148 ticks
printh("VERSION "..stat(5))
extcmd("set_filename","recording")
extcmd("audio_rec")
sfx(8,0)
for i=1,52 do flip() end
extcmd("audio_end",1)
printh("ALLDONE")
while true do flip() end
