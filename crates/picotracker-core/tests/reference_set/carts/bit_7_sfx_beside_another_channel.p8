version 43
__lua__
-- picotracker reference case bit_7_sfx_beside_another_channel: records 160 ticks
printh("VERSION "..stat(5))
extcmd("set_filename","recording")
extcmd("audio_rec")
music(0)
for i=1,55 do flip() end
extcmd("audio_end",1)
printh("ALLDONE")
while true do flip() end
