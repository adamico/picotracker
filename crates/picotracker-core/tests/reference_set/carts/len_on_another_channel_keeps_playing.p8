__lua__
-- picotracker reference case len_on_another_channel_keeps_playing: records 288 ticks
printh("VERSION "..stat(5))
extcmd("set_filename","recording")
extcmd("audio_rec")
music(0)
for i=1,87 do flip() end
extcmd("audio_end",1)
printh("ALLDONE")
while true do flip() end
