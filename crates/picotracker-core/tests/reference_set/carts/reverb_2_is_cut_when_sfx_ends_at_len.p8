pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- picotracker reference case reverb_2_is_cut_when_sfx_ends_at_len: records 84 ticks
printh("VERSION "..stat(5))
extcmd("set_filename","recording")
extcmd("audio_rec")
sfx(8,0)
for i=1,36 do flip() end
extcmd("audio_end",1)
printh("ALLDONE")
while true do flip() end
