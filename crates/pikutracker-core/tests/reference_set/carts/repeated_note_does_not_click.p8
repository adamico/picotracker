pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- pikutracker reference case repeated_note_does_not_click: records 84 ticks
printh("VERSION "..stat(5))
extcmd("set_filename","recording")
extcmd("audio_rec")
sfx(8,0)
for i=1,36 do flip() end
extcmd("audio_end",1)
printh("ALLDONE")
while true do flip() end
