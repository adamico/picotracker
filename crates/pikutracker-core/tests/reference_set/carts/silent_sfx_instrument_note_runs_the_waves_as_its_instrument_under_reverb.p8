-- pikutracker reference case silent_sfx_instrument_note_runs_the_waves_as_its_instrument_under_reverb: records 100 ticks
printh("VERSION "..stat(5))
extcmd("set_filename","recording")
extcmd("audio_rec")
sfx(8,0)
for i=1,40 do flip() end
extcmd("audio_end",1)
printh("ALLDONE")
while true do flip() end
