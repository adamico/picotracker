pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- pikutracker reference case silent_looping_step_after_1_step: records 160 ticks
printh("VERSION "..stat(5))
extcmd("set_filename","recording")
extcmd("audio_rec")
music(0)
for i=1,55 do flip() end
extcmd("audio_end",1)
printh("ALLDONE")
while true do flip() end
