pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- pikutracker reference case every_pitch_from_0_to_31: records 520 ticks
printh("VERSION "..stat(5))
extcmd("set_filename","recording")
extcmd("audio_rec")
sfx(8,0)
for i=1,145 do flip() end
extcmd("audio_end",1)
printh("ALLDONE")
while true do flip() end
